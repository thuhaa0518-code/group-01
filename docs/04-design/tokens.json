{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "primary": {
      "50": { "$value": "#EEF2FF", "$type": "color", "$description": "Active item background, light highlight" },
      "100": { "$value": "#E0E7FF", "$type": "color" },
      "200": { "$value": "#C7D2FE", "$type": "color" },
      "500": { "$value": "#6366F1", "$type": "color" },
      "600": { "$value": "#4F46C6", "$type": "color", "$description": "Primary brand color, buttons, active states" },
      "700": { "$value": "#4338A8", "$type": "color", "$description": "Primary hover and pressed states" },
      "800": { "$value": "#3730A3", "$type": "color" }
    },
    "neutral": {
      "50": { "$value": "#F9FAFB", "$type": "color" },
      "100": { "$value": "#F2F4F7", "$type": "color", "$description": "Skeleton loading, subtle badges" },
      "300": { "$value": "#D0D5DD", "$type": "color", "$description": "Input borders, dividers" },
      "500": { "$value": "#667085", "$type": "color", "$description": "Placeholder text, metadata, captions" },
      "700": { "$value": "#344054", "$type": "color", "$description": "Form labels, secondary text" },
      "900": { "$value": "#101828", "$type": "color", "$description": "Headings, high contrast text" }
    },
    "canvas": { "$value": "#F5F6F8", "$type": "color", "$description": "App canvas background" },
    "surface": {
      "default": { "$value": "#FFFFFF", "$type": "color", "$description": "Card, table, panel background" },
      "muted": { "$value": "#F9FAFB", "$type": "color", "$description": "Table header, zebra striping" }
    },
    "border": {
      "default": { "$value": "#D0D5DD", "$type": "color" },
      "subtle": { "$value": "#EAECF0", "$type": "color" }
    },
    "text": {
      "onPrimary": { "$value": "#FFFFFF", "$type": "color" }
    },
    "success": {
      "50": { "$value": "#ECFDF3", "$type": "color" },
      "600": { "$value": "#16803C", "$type": "color", "$description": "Approved, completed, confirm buttons" },
      "700": { "$value": "#027A48", "$type": "color" }
    },
    "warning": {
      "50": { "$value": "#FFFAEB", "$type": "color" },
      "700": { "$value": "#B54708", "$type": "color", "$description": "Budget warning, anomaly alert, revision" }
    },
    "danger": {
      "50": { "$value": "#FEF3F2", "$type": "color" },
      "600": { "$value": "#B42318", "$type": "color", "$description": "Reject, discrepancy, error banners" }
    },
    "info": {
      "50": { "$value": "#F0F9FF", "$type": "color" },
      "600": { "$value": "#026AA2", "$type": "color", "$description": "AI assistance, info banners, sourcing" }
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "borderRadius": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "6px", "$type": "dimension" },
    "lg": { "$value": "8px", "$type": "dimension" },
    "xl": { "$value": "12px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "fontFamily": {
    "primary": { "$value": "Inter, ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" }
  },
  "fontSize": {
    "pageTitle": { "$value": "28px", "$type": "dimension" },
    "sectionTitle": { "$value": "20px", "$type": "dimension" },
    "body": { "$value": "14px", "$type": "dimension" },
    "caption": { "$value": "12px", "$type": "dimension" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px rgba(16, 24, 40, 0.05)", "$type": "shadow" },
    "md": { "$value": "0 4px 8px -2px rgba(16, 24, 40, 0.10)", "$type": "shadow" },
    "lg": { "$value": "0 12px 16px -4px rgba(16, 24, 40, 0.08)", "$type": "shadow" }
  }
}
